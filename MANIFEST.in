include README.md CONTRIBUTING.md ARCHITECTURE.md CHANGELOG.md AGENTS.md LICENSE pyproject.toml MANIFEST.in package.json package-lock.json .gitignore .gitattributes
recursive-include src *.py
recursive-include tests *.py
recursive-include scripts *.py
recursive-include contracts *.json *.md
recursive-include docs *.md
recursive-include architecture *.yaml *.md
recursive-include skills *.md *.yaml
recursive-include npm *.cjs
recursive-include .github *.yml
prune npm/runtime
prune .archctl
prune .briefcase
prune .venv
global-exclude __pycache__ *.py[cod] *.log
